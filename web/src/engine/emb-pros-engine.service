# EMB Pros engine as a service on a VPS (systemd): starts with the server, restarts if it stops.
# Copy to /etc/systemd/system/, set the path, user and key, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now emb-pros-engine
[Unit]
Description=EMB Pros engine
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/emb-pros/engine
Environment=EMB_ENGINE_KEY=change-me-to-the-same-text-as-config.php
Environment=EMB_KEEP=32
ExecStart=/var/www/emb-pros/engine/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
